{
  "name": "@local/dsh-excalidraw",
  "version": "0.0.0-spike",
  "private": true,
  "type": "module",
  "description": "Spike DSH client package wrapping the genuine @excalidraw/excalidraw 0.18.1 React component",
  "main": "./lib/index.js",
